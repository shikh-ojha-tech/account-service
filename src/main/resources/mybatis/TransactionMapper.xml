<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.account.persistence.TransactionMapper">

    <resultMap id="TransactionResultMap" type="com.account.domain.Transaction">
        <id property="transactionId" column="transaction_id" javaType="java.util.UUID"/>
        <result property="accountId" column="account_id" javaType="java.util.UUID"/>
        <result property="amount" column="amount"/>
        <result property="currency" column="currency" javaType="com.account.domain.Currency"/>
        <result property="direction" column="direction" javaType="com.account.domain.Direction"/>
        <result property="description" column="description"/>
        <result property="balanceAfterTransaction" column="balance_after_transaction"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO account_transaction (
            transaction_id,
            account_id,
            amount,
            currency,
            direction,
            description,
            balance_after_transaction
        ) VALUES (
            #{transactionId, javaType=java.util.UUID},
            #{accountId, javaType=java.util.UUID},
            #{amount},
            #{currency},
            #{direction},
            #{description},
            #{balanceAfterTransaction}
        )
    </insert>

    <select id="findByAccountId" resultMap="TransactionResultMap">
        SELECT transaction_id,
               account_id,
               amount,
               currency,
               direction,
               description,
               balance_after_transaction
        FROM account_transaction
        WHERE account_id = #{accountId, javaType=java.util.UUID}
        ORDER BY ledger_seq DESC
    </select>

</mapper>
